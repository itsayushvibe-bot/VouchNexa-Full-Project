# Copy to .env locally and fill in your own values. Never commit .env.
BOT_TOKEN=replace-with-a-new-token-from-BotFather
OWNER_ID=replace-with-your-telegram-user-id
MAIN_CHANNEL=@your-main-channel
DEALS_CHANNEL=@your-deals-channel
LOGS_CHANNEL=@your-logs-channel
SUPPORT_BOT=@your-support-bot
DEFAULT_UPI_ID=your-upi-id
DEFAULT_UPI_NAME=your-upi-name
# Local: sqlite+aiosqlite:///./vouchnexa.db
# Production: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///./vouchnexa.db
